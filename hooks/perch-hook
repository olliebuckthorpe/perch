#!/bin/sh
# Forwards a Claude Code or Codex hook event to Perch and prints Perch's answer.
# usage: perch-hook <claude|codex> <info|permission|ask|stop|wait>   (event JSON on stdin)
#
# Fails open: if Perch is not running this exits 0 with no output, so the agent
# behaves exactly as it would without the hook.

# Perch's own helper runs (writing a chat title, for one) are not chats and stay out of the notch.
# The one exception is the status line, which only carries how much of the plan is used.
[ -n "$PERCH_SKIP" ] && [ "$2" != "status" ] && exit 0

SOCK="$HOME/.perch/perch.sock"

post() {
  curl -s --unix-socket "$SOCK" --max-time "$1" -X POST \
    -H "Content-Type: application/json" -H "Expect:" \
    -H "X-Perch-Source: $SRC" -H "X-Perch-Mode: $MODE" \
    -H "X-Perch-Entrypoint: ${CLAUDE_CODE_ENTRYPOINT:-}" \
    -H "X-Perch-Term: ${TERM_PROGRAM:-}" \
    -H "X-Perch-Headless: ${PERCH_HEADLESS:-0}" \
    --data-binary @- http://perch/hook 2>/dev/null
}

SRC="$1"
MODE="${2:-info}"

# A waiter runs in the background after each turn. If a reply is typed in the notch while the
# session is idle, exiting 2 wakes the session with that reply (Claude Code's asyncRewake).
# It reconnects if Perch restarts, and gives up once Perch has been gone for ten minutes.
if [ "$MODE" = "wait" ]; then
  BODY=$(cat)
  GONE=0
  while [ "$GONE" -lt 120 ]; do
    if [ -S "$SOCK" ] && OUT=$(printf '%s' "$BODY" | post 86000); then
      # Perch answered. Empty means a newer waiter took over for this session.
      [ -n "$OUT" ] || exit 0
      printf '%s\n' "$OUT" >&2
      exit 2
    fi
    GONE=$((GONE + 1))
    sleep 5
  done
  exit 0
fi

[ -S "$SOCK" ] || exit 0

case "$MODE" in
  permission|ask) MAX=300 ;;
  stop) MAX=590 ;;
  status) MAX=1 ;;
  *) MAX=2 ;;
esac

post "$MAX"
exit 0
