#!/bin/sh
# Forwards a Claude Code or Codex hook event to Perch and prints Perch's answer.
# usage: perch-hook <claude|codex> <info|permission|ask|stop>   (event JSON on stdin)
#
# Fails open: if Perch is not running this exits 0 with no output, so the agent
# behaves exactly as it would without the hook.

SOCK="$HOME/.perch/perch.sock"
[ -S "$SOCK" ] || exit 0

case "$2" in
  permission|ask) MAX=300 ;;
  stop) MAX=590 ;;
  *) MAX=2 ;;
esac

curl -s --unix-socket "$SOCK" --max-time "$MAX" -X POST \
  -H "Content-Type: application/json" -H "Expect:" \
  -H "X-Perch-Source: $1" -H "X-Perch-Mode: ${2:-info}" \
  -H "X-Perch-Entrypoint: ${CLAUDE_CODE_ENTRYPOINT:-}" \
  -H "X-Perch-Term: ${TERM_PROGRAM:-}" \
  -H "X-Perch-Headless: ${PERCH_HEADLESS:-0}" \
  --data-binary @- http://perch/hook 2>/dev/null
exit 0
